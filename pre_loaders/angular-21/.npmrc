# Dependency install-script policy (npm RFC 868, enforced by npm 11+/12).
# strict-allow-scripts makes installation fail if any dependency has an
# install-time lifecycle script that is not explicitly reviewed in this
# project's package.json `allowScripts` field. Reviewed-but-unnecessary
# scripted dependencies are denied there (name-only `false`), so no script
# runs; a newly introduced, unreviewed scripted dependency is rejected
# instead of being silently skipped.
strict-allow-scripts=true
