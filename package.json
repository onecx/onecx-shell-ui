{
  "name": "onecx-shell-ui",
  "private": true,
  "version": "0.0.0",
  "license": "Apache-2.0",
  "contributors": [
    "OneCX Development Team <onecx_dev@1000kit.org>"
  ],
  "config": {
    "openapiYaml": "src/assets/api/openapi-bff.yaml",
    "openapiOutput": "src/app/shared/generated"
  },
  "scripts": {
    "prebuild": "node ./create-dummies.js && bash ./build-preloaders.sh",
    "build": "nx build",
    "build-shell-only": "nx build",
    "build:18": "rm -rf pre_loaders/angular-18/.nx && node ./create-dummies.js && (cd ./pre_loaders/angular-18 && npm run build) && npm run build",
    "build:19": "rm -rf pre_loaders/angular-19/.nx && node ./create-dummies.js && (cd ./pre_loaders/angular-19 && npm run build) && npm run build",
    "build:20": "rm -rf pre_loaders/angular-20/.nx && node ./create-dummies.js && (cd ./pre_loaders/angular-20 && npm run build) && npm run build",
    "build:21": "rm -rf pre_loaders/angular-21/.nx && node ./create-dummies.js && (cd ./pre_loaders/angular-21 && npm run build) && npm run build",
    "build:react-19": "rm -rf pre_loaders/react-19/.nx && node ./create-dummies.js && (cd ./pre_loaders/react-19 && npm run build) && npm run build",
    "postbuild": "bash ./copy-preloaders.sh",
    "postinstall": "npm install --prefix pre_loaders/angular-18 && npm install --prefix pre_loaders/angular-19 && npm install --prefix pre_loaders/angular-20 && npm install --prefix pre_loaders/angular-21 && npm install --prefix pre_loaders/react-19",
    "check": "nx lint --cache=true && npx prettier -c --cache .",
    "clean": "npm cache clean --force && rm -rf *.log dist reports .nx pre_loaders/angular*/.nx pre_loaders/react-19/.nx .angular .eslintcache node_modules/.cache/prettier/.prettier-cache",
    "lint": "nx lint --cache=true",
    "format": "nx lint --fix",
    "eslint": "eslint --quiet --ext .js,.ts src",
    "browser": "npx browserslist",
    "prepare": "husky || true",
    "start": "nx serve --configuration=development --proxy-config=proxy.conf.js",
    "start:local-env": "nx serve --configuration=local-env --proxy-config=proxy.local-env.conf.js",
    "test": "nx test",
    "test:ci": "nx test --no-color --watch=false --browsers=ChromeHeadless --coverage",
    "sonar": "npx sonar-scanner",
    "apigen-cleanup": "rm -rf $npm_package_config_openapiOutput",
    "apigen-format": "npx prettier $npm_package_config_openapiYaml --write && npx prettier $npm_package_config_openapiOutput/**/* --write",
    "apigen-generate": "openapi-generator-cli generate -i $npm_package_config_openapiYaml -g typescript-angular -c apigen.yaml -o $npm_package_config_openapiOutput --type-mappings=AnyType=object,set=Array",
    "apigen": "npm run apigen-cleanup && npm run apigen-generate && npm run apigen-format"
  },
  "husky": {
    "hooks": {
      "pre-commit": "pretty-quick --staged"
    }
  },
  "nx": {
    "includedScripts": []
  },
  "jestSonar": {
    "reportPath": "reports"
  },
  "dependencies": {
    "@angular-devkit/architect": "^0.2202.0",
    "@angular/animations": "^22.0.0",
    "@angular/common": "^22.0.0",
    "@angular/compiler": "^22.0.0",
